        "sentences": [
          {
            "id": "s1",
            "text": "People use a lot of plastic."
          },
          {
            "id": "s2",
            "text": "Plastic is cheap and convenient."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "You use a plastic straw once."
          },
          {
            "id": "s4",
            "text": "Then you throw it away."
          },
          {
            "id": "s5",
            "text": "This is a big problem."
          },
          {
            "id": "s6",
            "text": "A lot of straws go into the sea."
          },
          {
            "id": "s7",
            "text": "They hurt the plants and animals."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "Molly Steer is nine years old."
          },
          {
            "id": "s9",
            "text": "But she teaches people about not using plastic straws."
          },
          {
            "id": "s10",
            "text": "She says that millions of straws are used each day."
          },
          {
            "id": "s11",
            "text": "Because of her, several countries stopped using plastic straws."
          }
        ]
      }
    ]
  },
