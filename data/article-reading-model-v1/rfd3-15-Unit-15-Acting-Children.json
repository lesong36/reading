          {
            "id": "s1",
            "text": "Children aren’t allowed to do most jobs."
          },
          {
            "id": "s2",
            "text": "But they’re allowed to act."
          },
          {
            "id": "s3",
            "text": "Children act in movies."
          },
          {
            "id": "s4",
            "text": "They act in television shows."
          },
          {
            "id": "s5",
            "text": "They also act in online videos."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "Many children make online videos."
          },
          {
            "id": "s7",
