          {
            "id": "s11",
            "text": "They also say what they don’t like."
          },
          {
            "id": "s12",
            "text": "Some child actors are very successful."
          },
          {
            "id": "s13",
            "text": "They’re famous."
          },
          {
            "id": "s14",
            "text": "They make a lot of money, too."
          }
        ]
      }
