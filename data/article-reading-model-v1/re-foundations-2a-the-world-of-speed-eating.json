            "role": "topic_sentence"
          }
        ]
      },
      {
        "id": "p4",
        "topic": {
          "label": "观点与争议"
        },
        "main_idea": {
          "text": "虽然有人质疑竞技进食的健康性和道德性，但参赛者将其视为一种体育运动。"
        },
        "key_details": [
          {
            "source_ids": [
              "s19",
              "s20"
            ],
            "meaning": "批评者认为这对参赛者不健康，且在世界仍有饥饿人口时显得不合时宜。"
          },
          {
            "source_ids": [
              "s23"
            ],
            "meaning": "对于竞技进食者来说，这与其他运动无异。"
          },
          {
            "source_ids": [
              "s24"
            ],
            "meaning": "小冢表示“食物斗士”自视为运动员。"
          }
        ],
