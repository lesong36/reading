{
  "schema_version": "1.0",
  "article": {
    "id": "re-foundations-2a-the-world-of-speed-eating",
    "title": "RE Foundations / 2A / The World of Speed Eating",
    "text_type": "informational",
    "audience": {
      "grade_band": "upper_elementary"
    },
