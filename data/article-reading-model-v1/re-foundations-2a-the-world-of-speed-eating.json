      },
      {
        "id": "p3",
        "topic": {
          "label": "著名冠军"
        },
        "main_idea": {
          "text": "乔伊·切斯特纳特和塔克·小冢是竞技进食领域的著名冠军，他们分别保持着不同的世界纪录。"
        },
        "key_details": [
          {
            "source_ids": [
              "s13",
              "s14"
            ],
            "meaning": "乔伊·切斯特纳特在不到10分钟内吃了74个热狗，创下世界纪录。"
          },
          {
            "source_ids": [
              "s16"
            ],
            "meaning": "来自日本的塔克·小冢曾多年担任纳森大赛冠军。"
          },
          {
            "source_ids": [
              "s17",
              "s18"
            ],
            "meaning": "小冢体型较小，但持有多种食物的进食世界纪录。"
          }
        ],
        "function": {
          "type": "detail"
        },
        "relation_to_previous": {
          "type": "extension",
          "target": "p2"
        },
        "signals": [
          {
