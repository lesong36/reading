  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Waste is a problem all around the world."
          },
          {
            "id": "s2",
            "text": "It’s even a problem in space."
          },
          {
            "id": "s3",
            "text": "People have left 8,000 tonnes of trash there."
          },
          {
            "id": "s4",
            "text": "It’s called space debris."
          },
          {
            "id": "s5",
            "text": "It goes around the Earth dangerously fast."
          },
          {
            "id": "s6",
            "text": "It can hit spaceships and even Earth."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s7",
            "text": "It’s time to clean it up."
          },
          {
            "id": "s8",
            "text": "One solution scientists have invented is a giant net to catch trash."
          },
          {
            "id": "s9",
            "text": "The scientists will use powerful cameras to find the trash."
          },
          {
            "id": "s10",
            "text": "They will catch it and slow"
          },
          {
            "id": "s11",
            "text": "it down."
          },
          {
            "id": "s12",
            "text": "Then they can bring it back to Earth."
          }
        ]
      }
    ]
  },
