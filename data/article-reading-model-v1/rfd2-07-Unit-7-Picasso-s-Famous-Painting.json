        "sentences": [
          {
            "id": "s1",
            "text": "Pablo Picasso was a famous painter."
          },
          {
            "id": "s2",
            "text": "He is famous for his art style."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "In 1921, he painted two pictures."
          },
          {
            "id": "s4",
            "text": "They are both called The Three Musicians."
          },
          {
            "id": "s5",
            "text": "They show three men playing music."
          },
          {
            "id": "s6",
            "text": "Their bodies look like puzzles."
          },
          {
            "id": "s7",
            "text": "Their faces look strange."
          },
          {
            "id": "s8",
            "text": "The colors are unusual."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "People loved this new style."
          },
          {
            "id": "s10",
            "text": "This art was different."
          },
          {
            "id": "s11",
            "text": "It was new."
          },
          {
            "id": "s12",
            "text": "It was exciting."
          },
          {
            "id": "s13",
            "text": "Other artists started painting this way."
          },
          {
            "id": "s14",
            "text": "Picasso changed the art world."
          }
        ]
      }
    ]
  },
