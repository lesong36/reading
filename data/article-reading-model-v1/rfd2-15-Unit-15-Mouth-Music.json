        "sentences": [
          {
            "id": "s1",
            "text": "There are many ways to make music."
          },
          {
            "id": "s2",
            "text": "You can use musical instruments."
          },
          {
            "id": "s3",
            "text": "You can also use your mouth."
          },
          {
            "id": "s4",
            "text": "You can sing."
          },
          {
            "id": "s5",
            "text": "You can whistle."
          },
          {
            "id": "s6",
            "text": "Or you can beatbox."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s7",
            "text": "Beatboxing became popular in the 1980s."
          },
          {
            "id": "s8",
            "text": "People use their mouths to make sounds."
          },
          {
            "id": "s9",
            "text": "They make beats."
          },
          {
            "id": "s10",
            "text": "They also use their hands and bodies to make sounds."
          },
          {
            "id": "s11",
            "text": "Sometimes they also sing or rap."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s12",
            "text": "Today, beatboxing is still very popular."
          },
          {
            "id": "s13",
            "text": "It’s a big part of hip-hop music."
          }
        ]
      }
    ]
