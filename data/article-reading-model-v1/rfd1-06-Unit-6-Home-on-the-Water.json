  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Many people in Asia live on the water."
          },
          {
            "id": "s2",
            "text": "They don’t only live in houses near the water."
          },
          {
            "id": "s3",
            "text": "Many people live in houses built on boats!"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "People living on boats can use their homes to make money."
          },
          {
            "id": "s5",
            "text": "They keep fish in nets."
          },
          {
            "id": "s6",
            "text": "The nets are under their homes."
          },
          {
            "id": "s7",
            "text": "People sell the fish."
          },
          {
            "id": "s8",
            "text": "They eat the fish, too."
          },
          {
            "id": "s9",
            "text": "People lived this way for hundreds of years."
          },
          {
            "id": "s10",
            "text": "They still do."
          }
        ]
      }
    ]
  },
