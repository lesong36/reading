  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Sea cucumbers and earthworms do the same job."
          },
          {
            "id": "s2",
            "text": "They both keep their environment clean."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "The sea cucumber eats dirty sand from the bottom of the ocean."
          },
          {
            "id": "s4",
            "text": "It poops out clean sand."
          },
          {
            "id": "s5",
            "text": "It stirs the sand and keeps it from getting hard."
          },
          {
            "id": "s6",
            "text": "This keeps the ocean clean."
          },
          {
            "id": "s7",
            "text": "It helps"
          },
          {
            "id": "s8",
            "text": "animals and plants grow."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "The earthworm eats the garbage of the earth."
          },
          {
            "id": "s10",
            "text": "It turns the garbage into healthy food."
          },
          {
            "id": "s11",
            "text": "It also digs paths in the dirt."
          },
          {
            "id": "s12",
            "text": "Water and air can enter more easily."
          },
          {
            "id": "s13",
            "text": "Plants can grow better."
          }
        ]
      }
    ]
  },
