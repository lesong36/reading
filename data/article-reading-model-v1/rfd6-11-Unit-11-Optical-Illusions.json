      "structure": {
        "type": "cause_and_effect"
      },
      "central_idea": {
        "text": "视错觉发生是因为大脑在创造图像时会走捷径，有时会根据距离等线索错误地判断物体的大小或长度。"
      },
      "inferences": [
        {
          "id": "inf1",
          "claim": "大脑的“走捷径”机制是为了更高效地处理视觉信息，但这也可能导致错误。",
          "evidence": [
            {
              "source_id": "s4",
              "span": "But your brain also takes shortcuts."
            },
            {
              "source_id": "s6",
              "span": "These details are not always real."
            }
          ],
          "knowledge_bridge": "大脑处理信息需要时间和能量，走捷径是一种效率策略，但效率有时牺牲了准确性。",
          "difficulty": "medium"
        },
        {
          "id": "inf2",
          "claim": "在庞佐错觉中，大脑利用深度线索（如铁轨的透视）来推断物体的大小，即使这些线索是人为制造的。",
          "evidence": [
            {
              "source_id": "s9",
              "span": "It's a drawing of a train track."
            },
            {
              "source_id": "s13",
              "span": "The top one looks longer because your brain thinks it's further away."
            }
          ],
          "knowledge_bridge": "大脑使用透视等深度线索来估计物体的大小。当这些线索被操纵，大脑的估计 can be fooled. ",
          "difficulty": "high"
        }
      ]
    }
  },
