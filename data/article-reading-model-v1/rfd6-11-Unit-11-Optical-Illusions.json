{
  "schema_version": "1.0",
  "article": {
    "id": "rfd6-11-Unit-11-Optical-Illusions",
    "title": "RFD 6 / Unit 11 Optical Illusions",
    "text_type": "informational",
    "audience": {
      "grade_band": "upper_elementary"
    },
    "language": "en"
  },
  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Your eyes see color, lights, and patterns."
          },
          {
            "id": "s2",
            "text": "But your eyes don't make images; your brain does."
          },
          {
            "id": "s3",
            "text": "Your brain uses information from your eyes to create an image."
          },
          {
            "id": "s4",
            "text": "But your brain also takes shortcuts."
          },
          {
            "id": "s5",
            "text": "It fills in details."
          },
          {
            "id": "s6",
            "text": "These details are not always real."
          },
          {
            "id": "s7",
            "text": "When this happens, a person sees an optical illusion."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s8",
            "text": "Take the Ponzo illusion, for example."
          },
          {
            "id": "s9",
            "text": "It's a drawing of a train track."
          },
          {
            "id": "s10",
            "text": "On it, there are two yellow lines."
          },
          {
            "id": "s11",
            "text": "Which one looks longer?"
          },
          {
            "id": "s12",
            "text": "They're of equal length."
          },
          {
            "id": "s13",
            "text": "The top one looks longer because your brain thinks it's further away."
          }
        ]
      }
    ]
  },
  "analysis": {
    "paragraphs": [
      {
        "id": "p1",
        "topic": {
          "label": "大脑如何创造视觉"
        },
        "main_idea": {
          "text": "大脑利用眼睛的信息来创造图像，但有时会走捷径，导致我们看到不真实的细节，即视错觉。"
        },
        "key_details": [
          {
            "source_ids": [
              "s2",
              "s3"
            ],
            "meaning": "大脑，而不是眼睛，负责创造图像。"
          },
          {
            "source_ids": [
              "s4",
              "s5"
            ],
            "meaning": "大脑会走捷径，填补细节。"
          },
          {
            "source_ids": [
              "s6",
              "s7"
            ],
            "meaning": "这些填补的细节有时是不真实的，从而产生视错觉。"
          }
        ],
        "function": {
          "type": "introduction"
        },
        "relation_to_previous": null,
        "signals": [
          {
            "text": "But your brain also takes shortcuts.",
            "source_id": "s4",
            "role": "transition"
          },
          {
            "text": "When this happens, a person sees an optical illusion.",
            "source_id": "s7",
            "role": "conclusion"
          }
        ]
      },
      {
        "id": "p2",
        "topic": {
          "label": "庞佐错觉的例子"
        },
        "main_idea": {
          "text": "庞佐错觉是一个例子，说明大脑如何因为认为物体更远而错误地判断其长度。"
        },
        "key_details": [
          {
            "source_ids": [
              "s8",
              "s9"
            ],
            "meaning": "庞佐错觉是一个铁轨的图画。"
          },
          {
            "source_ids": [
              "s10",
              "s11",
              "s12"
            ],
            "meaning": "图画上有两条看起来长度不同但实际相等的黄线。"
          },
          {
            "source_ids": [
              "s13"
            ],
            "meaning": "上面的线看起来更长，因为大脑认为它更远。"
          }
        ],
        "function": {
          "type": "example"
        },
        "relation_to_previous": {
