  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Traditional animation is made with many pictures."
          },
          {
            "id": "s2",
            "text": "Each picture is drawn differently."
          },
          {
            "id": "s3",
            "text": "When shown quickly, these pictures appear to move."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "There are other kinds of animation."
          },
          {
            "id": "s5",
            "text": "Sand animation is a kind of performance art."
          },
          {
            "id": "s6",
            "text": "Artists use sand to make images."
          },
          {
            "id": "s7",
            "text": "They do this using a box with a light inside."
          },
          {
            "id": "s8",
            "text": "This creates an image with the shadows."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "Sand artists perform in front of an audience."
          },
          {
            "id": "s10",
            "text": "They use the sand to tell a story."
          },
          {
            "id": "s11",
            "text": "The first sand artist was a student at Harvard University."
          },
          {
            "id": "s12",
            "text": "She made a film in 1968."
          },
          {
            "id": "s13",
            "text": "It was called Sand, or Peter and the Wolf."
          }
        ]
      }
    ]
  },
