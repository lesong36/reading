  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "South Korea has millions of surveillance cameras."
          },
          {
            "id": "s2",
            "text": "The cameras are in public places everywhere."
          },
          {
            "id": "s3",
            "text": "They are on street blocks and in subway stations."
          },
          {
            "id": "s4",
            "text": "They are even in farm areas too!"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "South Koreans call them “CCTVs”."
          },
          {
            "id": "s6",
            "text": "CCTVs can recognize cars."
          },
          {
            "id": "s7",
            "text": "They can find stolen cars."
          },
          {
            "id": "s8",
            "text": "Some CCTVS can even recognize people’s faces."
          },
          {
            "id": "s9",
            "text": "They can help find criminals."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "South Korea wants less crime."
          },
          {
            "id": "s11",
            "text": "The cameras help control crime."
          },
          {
            "id": "s12",
            "text": "There are fewer people stealing."
          },
          {
            "id": "s13",
            "text": "CCTVs make people feel safe."
          },
          {
            "id": "s14",
            "text": "Are there CCTVs near you?"
          }
        ]
      }
    ]
  },
