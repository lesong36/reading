        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "People use codes to send messages secretly."
          },
          {
            "id": "s2",
            "text": "Some are simple."
          },
          {
            "id": "s3",
            "text": "One word means another word."
          },
          {
            "id": "s4",
            "text": "These codes are easy to “break” or understand."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "Some codes use math."
          },
          {
            "id": "s6",
            "text": "The Enigma code was one."
          },
          {
            "id": "s7",
            "text": "The Germans created it during World War II."
          },
          {
            "id": "s8",
            "text": "It used complicated math."
          },
          {
            "id": "s9",
            "text": "Alan Turing was great at math."
          },
          {
            "id": "s10",
            "text": "He worked for the UK government."
          },
          {
            "id": "s11",
            "text": "He broke the code!"
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s12",
            "text": "Americans used Navajo in their code."
          },
          {
            "id": "s13",
            "text": "Navajo is a Native American language."
          },
          {
            "id": "s14",
            "text": "Few people know it."
          },
          {
            "id": "s15",
            "text": "This code was never broken."
          }
        ]
      }
    ]
  },
