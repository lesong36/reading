    "title": "Unit 1 Why Are There Days and Seasons?",
    "text_type": "informational",
    "audience": {
      "grade_band": "upper_elementary"
    },
    "language": "en"
  },
  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "It’s light outside."
          },
          {
            "id": "s2",
            "text": "It’s dark outside."
          },
          {
            "id": "s3",
            "text": "Why does this happen?"
          },
          {
            "id": "s4",
            "text": "The earth is round."
          },
          {
            "id": "s5",
            "text": "It spins."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "We face the sun in the day."
          },
          {
            "id": "s7",
            "text": "We face away from the sun at night."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "The earth also moves around the sun."
          },
          {
            "id": "s9",
            "text": "This takes a year."
          },
          {
            "id": "s10",
            "text": "From April to September, the northern half of earth faces the sun."
          },
          {
            "id": "s11",
            "text": "So it’s warmer there."
          },
          {
            "id": "s12",
            "text": "From October to March, the southern half faces the sun."
          },
          {
            "id": "s13",
            "text": "Then it’s warmer there."
          },
          {
            "id": "s14",
            "text": "This is why we have seasons."
          }
        ]
      }
    ]
  },
