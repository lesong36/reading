              "s10",
              "s11"
            ],
            "meaning": "In the first half of the year, the northern half faces the sun and is warmer."
          },
          {
            "source_ids": [
              "s12",
              "s13"
            ],
            "meaning": "In the second half of the year, the southern half faces the sun and is warmer."
          }
        ],
