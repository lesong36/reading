          "label": "The Cause of Seasons"
        },
        "main_idea": {
          "text": "Seasons happen because the earth's movement around the sun changes which half of the earth faces the sun."
        },
        "key_details": [
          {
            "source_ids": [
              "s8",
              "s9"
            ],
            "meaning": "The earth travels around the sun in a year."
          },
