  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Trade started long ago."
          },
          {
            "id": "s2",
            "text": "It was easy to find the value of some goods."
          },
          {
            "id": "s3",
            "text": "For example, one cow was worth three goats."
          },
          {
            "id": "s4",
            "text": "But it was hard to count other goods, like spices."
          },
          {
            "id": "s5",
            "text": "Merchants weighed these goods."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "The first weighing system was simple."
          },
          {
            "id": "s7",
            "text": "Two plates hung from either side of a bar."
          },
          {
            "id": "s8",
            "text": "One plate held the goods."
          },
          {
            "id": "s9",
            "text": "On the other, the merchant placed stones."
          },
          {
            "id": "s10",
            "text": "All merchants used stones of the same size and weight."
          },
          {
            "id": "s11",
            "text": "Stones were added until the two plates were equal."
          },
          {
            "id": "s12",
            "text": "Then, the goods weighed the same as the stones."
          }
        ]
      }
    ]
  },
