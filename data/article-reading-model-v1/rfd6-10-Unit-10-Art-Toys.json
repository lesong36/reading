  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Designer toys or \"art toys\" are collectibles."
          },
          {
            "id": "s2",
            "text": "Unlike teddy bears and dolls, art toys are not for playing with."
          },
          {
            "id": "s3",
            "text": "They are for viewing."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "Artists make art toys."
          },
          {
            "id": "s5",
            "text": "Some are famous painters."
          },
          {
            "id": "s6",
            "text": "Some are comic book artists."
          },
          {
            "id": "s7",
            "text": "Some are even graffiti artists."
          },
          {
            "id": "s8",
            "text": "They make art toys with plastic and other more unusual materials."
          },
          {
            "id": "s9",
            "text": "They make them in limited numbers."
          },
          {
            "id": "s10",
            "text": "They can be very expensive."
          },
          {
            "id": "s11",
            "text": "Some sell for thousands of dollars."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s12",
            "text": "Designer toys first appeared in the 1990s."
          },
          {
            "id": "s13",
            "text": "Now there are many kinds."
          },
          {
            "id": "s14",
            "text": "For example, Qees, Be@rbricks, and Dunnys."
          },
          {
            "id": "s15",
            "text": "Have you ever seen one of these?"
          }
        ]
      }
    ]
  },
