          {
            "id": "s1",
            "text": "Do you like your body?"
          },
          {
            "id": "s2",
            "text": "Many people say no."
          },
          {
            "id": "s3",
            "text": "They compare themselves to others."
          },
          {
            "id": "s4",
            "text": "They see beautiful people in magazines."
          },
          {
            "id": "s5",
            "text": "Then they feel bad."
          },
          {
            "id": "s6",
            "text": "Most people don’t look like that."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s7",
            "text": "These pictures aren’t real."
          },
          {
