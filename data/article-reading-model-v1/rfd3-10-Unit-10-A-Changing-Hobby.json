  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Photography was a new hobby in the 1880s."
          },
          {
            "id": "s2",
            "text": "People could take photographs with their own cameras."
          },
          {
            "id": "s3",
            "text": "With a camera, anyone could be an artist."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "People needed film."
          },
          {
            "id": "s5",
            "text": "The Kodak Company made it."
          },
          {
            "id": "s6",
            "text": "By the 1980s, Kodak sold most of the film in the world."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s7",
            "text": "Photography changed in the 1990s."
          },
          {
            "id": "s8",
            "text": "People had computers."
          },
          {
            "id": "s9",
            "text": "They took digital pictures."
          },
          {
            "id": "s10",
            "text": "These pictures don’t need film."
          }
        ]
      },
      {
        "id": "p4",
        "order": 4,
        "sentences": [
          {
            "id": "s11",
            "text": "Kodak lost many customers."
          },
          {
            "id": "s12",
            "text": "It also started losing money."
          },
          {
            "id": "s13",
            "text": "In 2012, it stopped selling film."
          }
        ]
      }
    ]
  },
