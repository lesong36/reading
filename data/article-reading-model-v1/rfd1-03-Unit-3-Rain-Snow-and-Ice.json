            }
          ],
          "knowledge_bridge": "理解冰雹的形成需要水在云中多次上下移动并结冰，而雨和雪的形成过程相对简单。",
          "difficulty": "medium"
        },
        {
          "id": "inf2",
          "claim": "冰雹可能比雨和雪更危险。",
          "evidence": [
