  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "The mantis shrimp is a tiny sea creature."
          },
          {
            "id": "s2",
            "text": "It’s only 10 cm long."
          },
          {
            "id": "s3",
            "text": "Don’t let its size fool you."
          },
          {
            "id": "s4",
            "text": "The mantis shrimp has a secret."
          },
          {
            "id": "s5",
            "text": "It has superhero strength."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "This shrimp’s punch has the same force as a gunshot."
          },
          {
            "id": "s7",
            "text": "It uses its super punch for hunting."
          },
          {
            "id": "s8",
            "text": "The mantis shrimp’s punch is also very quick."
          },
          {
            "id": "s9",
            "text": "In the blink of an eye, it can punch"
          },
          {
            "id": "s10",
            "text": "500 times!"
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s11",
            "text": "That’s not all."
          },
          {
            "id": "s12",
            "text": "The mantis shrimp’s eyes are also interesting."
          },
          {
            "id": "s13",
            "text": "Unlike humans, they can even see ultraviolet light."
          }
        ]
      }
    ]
  },
