  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "How did people first protect their homes?"
          },
          {
            "id": "s2",
            "text": "Farm animals, dogs, and even geese did the job!"
          },
          {
            "id": "s3",
            "text": "They make noise when they hear things."
          },
          {
            "id": "s4",
            "text": "Dogs were kept as pets thousands of years ago for this reason."
          },
          {
            "id": "s5",
            "text": "Dogs have good hearing."
          },
          {
            "id": "s6",
            "text": "They have a strong sense of smell."
          },
          {
            "id": "s7",
            "text": "Food can take their attention."
          },
          {
            "id": "s8",
            "text": "They need to be trained."
          },
          {
            "id": "s9",
            "text": "Today, they still protect the home."
          },
          {
            "id": "s10",
            "text": "This is called an animal-based security system."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s11",
            "text": "There were also non-animal-based security systems."
          },
          {
            "id": "s12",
            "text": "A man named Tildesley made the first door alarm."
          }
        ]
      }
    ]
  },
  "analysis": {
