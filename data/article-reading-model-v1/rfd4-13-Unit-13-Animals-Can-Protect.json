        "topic": {
          "label": "动物安保系统"
        },
        "main_idea": {
          "text": "动物（如狗和鹅）通过发出噪音来保护人类家园，这种系统被称为基于动物的安保系统。"
        },
        "key_details": [
          {
            "source_ids": [
              "s2",
              "s3"
            ],
            "meaning": "农场动物、狗和鹅通过听到动静时发出噪音来执行保护任务。"
          },
          {
            "source_ids": [
              "s5",
              "s6"
            ],
            "meaning": "狗拥有良好的听觉和强烈的嗅觉，使其适合担任守卫角色。"
          },
          {
            "source_ids": [
              "s10"
            ],
            "meaning": "这种利用动物保护家园的方法被称为基于动物的安保系统。"
