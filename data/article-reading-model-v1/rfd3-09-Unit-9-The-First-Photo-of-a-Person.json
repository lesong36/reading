        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "In the past, taking a photograph took a long time."
          },
          {
            "id": "s2",
            "text": "In 1838, Louis Daguerre experimented with a new camera."
          },
          {
            "id": "s3",
            "text": "This camera was fast."
          },
          {
            "id": "s4",
            "text": "It took only 10 minutes to take a picture."
          },
          {
            "id": "s5",
            "text": "He took a picture of a street."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "The people on the street moved too fast."
          },
          {
            "id": "s7",
            "text": "They disappeared from the photograph."
          },
          {
            "id": "s8",
            "text": "Only one man stood still long enough."
          },
          {
            "id": "s9",
            "text": "He was having his shoes cleaned."
          },
          {
            "id": "s10",
            "text": "He was the first person ever photographed."
          },
          {
            "id": "s11",
            "text": "But no one knows who he was."
          }
        ]
      }
    ]
  },
