  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "When you watch baseball, you may notice something strange."
          },
          {
            "id": "s2",
            "text": "The players use a variety of hand signs."
          },
          {
            "id": "s3",
            "text": "Sometimes, a player holds up his fingers."
          },
          {
            "id": "s4",
            "text": "Sometimes, he touches his glove or head."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "There’s a good reason."
          },
          {
            "id": "s6",
            "text": "The pitcher and other players stand far apart."
          },
          {
            "id": "s7",
            "text": "But they need to communicate information about the game."
          },
          {
            "id": "s8",
            "text": "They can’t shout to each other."
          },
          {
            "id": "s9",
            "text": "They need to keep their plans secret."
          },
          {
            "id": "s10",
            "text": "So they make different signs with their hands."
          },
          {
            "id": "s11",
            "text": "Each team uses different signs."
          },
          {
            "id": "s12",
            "text": "And they change them often so other teams don’t learn them."
          }
        ]
      }
    ]
  },
