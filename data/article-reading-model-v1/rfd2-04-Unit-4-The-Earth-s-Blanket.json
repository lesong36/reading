        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "The earth is in danger!"
          },
          {
            "id": "s2",
            "text": "There are huge rocks in space."
          },
          {
            "id": "s3",
            "text": "They are dangerous!"
          },
          {
            "id": "s4",
            "text": "The sun’s light is strong."
          },
          {
            "id": "s5",
            "text": "It could hurt us."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "But don’t worry."
          },
          {
            "id": "s7",
            "text": "The earth has an atmosphere."
          },
          {
            "id": "s8",
            "text": "The atmosphere is the air around the earth."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "The atmosphere is like a blanket."
          },
          {
            "id": "s10",
            "text": "It keeps the earth warm."
          },
          {
            "id": "s11",
            "text": "It stops rocks."
          },
          {
            "id": "s12",
            "text": "Rocks coming toward the earth burn in the atmosphere."
          },
          {
            "id": "s13",
            "text": "We call them “shooting stars.”"
          },
          {
            "id": "s14",
            "text": "The atmosphere also makes sunshine safer for us."
          }
        ]
      }
    ]
  },
