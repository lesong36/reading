  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "People like looking at the moon."
          },
          {
            "id": "s2",
            "text": "In the past, people did it, too."
          },
          {
            "id": "s3",
            "text": "They wondered what the moon is made of."
          },
          {
            "id": "s4",
            "text": "Some people guessed, “Green cheese!”"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "In 1969, people landed on the moon."
          },
          {
            "id": "s6",
            "text": "The moon moves around the earth."
          },
          {
            "id": "s7",
            "text": "The moon is big, but it’s smaller than the earth."
          },
          {
            "id": "s8",
            "text": "It’s about 384,400 km away."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "We still have questions about the moon."
          },
          {
            "id": "s10",
            "text": "But we know some things."
          },
          {
            "id": "s11",
            "text": "For example, it's made of rock, not green cheese!"
          }
        ]
      }
    ]
  },
