        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Deaf people’s ears don’t work well."
          },
          {
            "id": "s2",
            "text": "They can’t hear sounds like others."
          },
          {
            "id": "s3",
            "text": "Some deaf people can talk with no problems."
          },
          {
            "id": "s4",
            "text": "But, some deaf people can’t speak well."
          },
          {
            "id": "s5",
            "text": "They use sign language."
          },
          {
            "id": "s6",
            "text": "They make signs with their hands."
          },
          {
            "id": "s7",
            "text": "The signs stand for words or letters."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s8",
            "text": "Sign language is useful for deaf people."
          },
          {
            "id": "s9",
            "text": "But, many people don’t know sign language."
          },
          {
            "id": "s10",
            "text": "This can make communication hard."
          },
          {
            "id": "s11",
            "text": "But computers can help."
          },
          {
            "id": "s12",
            "text": "Deaf people can write messages to anyone who doesn’t know sign language."
          }
        ]
      }
    ]
  },
