  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Narwhals are interesting creatures."
          },
          {
            "id": "s2",
            "text": "They live in the Arctic Ocean."
          },
          {
            "id": "s3",
            "text": "You can spot them by their unusual-looking tusk."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "A narwhal tusk is actually a tooth."
          },
          {
            "id": "s5",
            "text": "Both male and female narwhals can have one."
          },
          {
            "id": "s6",
            "text": "It can grow very long."
          },
          {
            "id": "s7",
            "text": "Some can grow up to 2.7 meters long."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "Many people believed narwhals use their tusks to hunt."
          },
          {
            "id": "s9",
            "text": "This is not true."
          },
          {
            "id": "s10",
            "text": "Actually, scientists are not sure what they’re for."
          },
          {
            "id": "s11",
            "text": "Some believe they are used to sense things."
          },
          {
            "id": "s12",
            "text": "A cat"
          },
          {
            "id": "s13",
            "text": "uses its whiskers in the same way."
          }
        ]
      }
    ]
  },
