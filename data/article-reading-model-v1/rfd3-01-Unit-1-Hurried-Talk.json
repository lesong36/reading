  },
  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "People hurry a lot."
          },
          {
            "id": "s2",
            "text": "They don’t take time for phone calls."
          },
          {
            "id": "s3",
            "text": "They send texts."
          },
          {
            "id": "s4",
            "text": "Even then, people hurry."
          },
          {
            "id": "s5",
            "text": "They don’t spell whole words."
          },
          {
            "id": "s6",
            "text": "They only use a few letters."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s7",
            "text": "LOL means “laughing out loud.”"
          },
          {
            "id": "s8",
            "text": "BRB means “be right back.”"
          },
          {
            "id": "s9",
            "text": "And SMH means “shaking my head.”"
          },
          {
            "id": "s10",
            "text": "People often use these letters in texts."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s11",
            "text": "But this can be a problem."
          },
          {
            "id": "s12",
            "text": "Some people think LOL means “lots of love.”"
          },
          {
            "id": "s13",
            "text": "They read bad news and answer LOL."
          },
          {
            "id": "s14",
            "text": "Oops!"
          }
        ]
      }
    ]
  },
  "analysis": {
    "paragraphs": [
      {
        "id": "p1",
        "topic": {
          "label": "Hurry in Communication"
        },
        "main_idea": {
          "text": "People are in a hurry when they communicate, so they use short texts instead of phone calls and abbreviate words."
        },
        "key_details": [
          {
            "source_ids": [
              "s2",
              "s3"
            ],
            "meaning": "People prefer sending texts over making phone calls to save time."
          },
          {
            "source_ids": [
              "s5",
              "s6"
            ],
            "meaning": "Even in texts, people rush by using only a few letters instead of spelling out whole words."
          }
        ],
        "function": {
          "type": "introduction"
        },
        "relation_to_previous": null,
        "signals": [
