        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Each country’s flag is different."
          },
          {
            "id": "s2",
            "text": "The flags have different meanings."
          },
          {
            "id": "s3",
            "text": "Some show the country’s history."
          },
          {
            "id": "s4",
            "text": "Others show the country’s culture."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "The flag of South Korea has three parts."
          },
          {
            "id": "s6",
            "text": "The white part stands for peace."
          },
          {
            "id": "s7",
            "text": "There is a red and blue circle in the middle."
          },
          {
            "id": "s8",
            "text": "This is a taegeuk."
          },
          {
            "id": "s9",
            "text": "It means balance."
          },
          {
            "id": "s10",
            "text": "There are black lines in each corner."
          },
          {
            "id": "s11",
            "text": "These have different meanings."
          },
          {
            "id": "s12",
            "text": "They mean the sky, sun, moon, and earth."
          },
          {
            "id": "s13",
            "text": "These things are all important to Koreans."
          }
        ]
      }
    ]
  },
