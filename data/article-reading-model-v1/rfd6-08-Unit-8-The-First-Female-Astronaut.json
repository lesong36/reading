  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Valentina Tereshkova was the first woman in space."
          },
          {
            "id": "s2",
            "text": "Surprisingly, she was not a pilot; she was a skydiver."
          },
          {
            "id": "s3",
            "text": "She had done 126 jumps before entering the space program."
          },
          {
            "id": "s4",
            "text": "The program accepted her because of her special talents."
          },
          {
            "id": "s5",
            "text": "At the time, astronauts had to be good skydivers."
          },
          {
            "id": "s6",
            "text": "That’s because they had to jump from their spaceships before landing."
          },
          {
            "id": "s7",
            "text": "This was very dangerous."
          },
          {
            "id": "s8",
            "text": "It was also why Valentina was the best choice."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s9",
            "text": "In 1963, Valentina was launched into space."
          },
          {
            "id": "s10",
            "text": "She spent three days in space."
          },
          {
            "id": "s11",
            "text": "She went around the Earth 48 times."
          },
          {
            "id": "s12",
            "text": "After landing, she became world famous."
          }
        ]
      }
    ]
  },
