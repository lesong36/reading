  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Roald Amundsen was an extraordinary adventurer."
          },
          {
            "id": "s2",
            "text": "He found the Northwest Passage."
          },
          {
            "id": "s3",
            "text": "The route connects the Atlantic Ocean to the Pacific Ocean."
          },
          {
            "id": "s4",
            "text": "He discovered it in 1903."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "In 1911, Amundsen went to Antarctica."
          },
          {
            "id": "s6",
            "text": "He became the first man to reach the South Pole."
          },
          {
            "id": "s7",
            "text": "He traveled with five others and eleven dogs."
          },
          {
            "id": "s8",
            "text": "They traveled for 99 days in the freezing cold."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "Amundsen wasn’t finished with his adventures."
          },
          {
            "id": "s10",
            "text": "In 1926, he traveled to the Arctic."
          },
          {
            "id": "s11",
            "text": "He was the first to fly over the North Pole."
          },
          {
            "id": "s12",
            "text": "In 1928, he tried to rescue a lost crewmate."
          },
          {
            "id": "s13",
            "text": "Sadly, Amundsen disappeared and never returned."
          }
        ]
      }
    ]
  },
