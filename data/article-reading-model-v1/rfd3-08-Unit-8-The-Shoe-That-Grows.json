  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Kids grow fast."
          },
          {
            "id": "s2",
            "text": "Their feet grow fast, too."
          },
          {
            "id": "s3",
            "text": "As their feet grow, they need new shoes, but shoes are expensive."
          },
          {
            "id": "s4",
            "text": "Many people can’t afford to buy them."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "Not wearing shoes is bad for people’s feet."
          },
          {
            "id": "s6",
            "text": "They can get cuts."
          },
          {
            "id": "s7",
            "text": "Dirt gets into the cuts."
          },
          {
            "id": "s8",
            "text": "There are many diseases in dirt."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "The Shoe That Grows can help."
          },
          {
            "id": "s10",
            "text": "The shoe is made with special straps."
          },
          {
            "id": "s11",
            "text": "The straps can get longer as children grow."
          },
          {
            "id": "s12",
            "text": "Now kids can have shoes that grow with them."
          }
        ]
      }
    ]
  },
