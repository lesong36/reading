  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "It’s hard to see the shape of the earth."
          },
          {
            "id": "s2",
            "text": "The ground looks flat and it feels flat."
          },
          {
            "id": "s3",
            "text": "For a long time, people thought the earth really was flat."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "Around 500 BCE, Pythagoras looked at the moon."
          },
          {
            "id": "s5",
            "text": "He saw that it is round."
          },
          {
            "id": "s6",
            "text": "He thought the earth must be round, too."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s7",
            "text": "In 350 BCE, Aristotle tracked the stars."
          },
          {
            "id": "s8",
            "text": "They showed that the earth is round."
          },
          {
            "id": "s9",
            "text": "Later, scientists proved this is true."
          }
        ]
      }
    ]
  },
