  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "In the past, life was hard."
          },
          {
            "id": "s2",
            "text": "Everyone worked."
          },
          {
            "id": "s3",
            "text": "Men, women, and even children had jobs."
          },
          {
            "id": "s4",
            "text": "Some children lived in the country."
          },
          {
            "id": "s5",
            "text": "They worked on farms."
          },
          {
            "id": "s6",
            "text": "They fed animals."
          },
          {
            "id": "s7",
            "text": "They picked vegetables."
          },
          {
            "id": "s8",
            "text": "They collected eggs and milk."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s9",
            "text": "Other children lived in cities."
          },
          {
            "id": "s10",
            "text": "They polished shoes."
          },
          {
            "id": "s11",
            "text": "They cleaned houses."
          },
          {
            "id": "s12",
            "text": "They worked in factories with big machines."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s13",
            "text": "Many jobs were dangerous."
          },
          {
            "id": "s14",
            "text": "Children could get hurt."
          },
          {
            "id": "s15",
            "text": "Children could even be killed."
          },
          {
            "id": "s16",
            "text": "Governments made laws to protect children."
          },
          {
            "id": "s17",
            "text": "Today, children cannot do most jobs."
          }
        ]
      }
    ]
  },
