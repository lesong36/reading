  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Oshibana is a Japanese art style."
          },
          {
            "id": "s2",
            "text": "Oshibana artists use pressed flowers to create pictures."
          },
          {
            "id": "s3",
            "text": "They take live flowers and press them flat."
          },
          {
            "id": "s4",
            "text": "Then they dry them."
          },
          {
            "id": "s5",
            "text": "A common way to dry a flower is to press it between two pieces of paper."
          },
          {
            "id": "s6",
            "text": "This removes the water."
          },
          {
            "id": "s7",
            "text": "It also keeps the petals safe."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s8",
            "text": "Oshibana was first practiced in 16th-century Japan."
          },
          {
            "id": "s9",
            "text": "But pressed flowers have been popular for a long time."
          },
          {
            "id": "s10",
            "text": "Knights pressed flowers as souvenirs."
          },
          {
            "id": "s11",
            "text": "Scientists pressed flowers to study them."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s12",
            "text": "Give it a try!"
          },
          {
            "id": "s13",
            "text": "All you need is paper, a heavy book, and flowers."
          }
        ]
      }
    ]
  },
