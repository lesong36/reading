  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "The theremin is one of the first electronic instruments."
          },
          {
            "id": "s2",
            "text": "And it is very unusual."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "It doesn’t look like other musical instruments."
          },
          {
            "id": "s4",
            "text": "It is just a wooden box with two antennas."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s5",
            "text": "The way that you play the theremin is also strange."
          },
          {
            "id": "s6",
            "text": "You don’t touch it, like a piano or guitar."
          },
          {
            "id": "s7",
            "text": "You wave your hands in the air near the antennas."
          },
          {
            "id": "s8",
            "text": "Your hands change an electric"
          },
          {
            "id": "s9",
            "text": "current."
          },
          {
            "id": "s10",
            "text": "This changes the sound."
          }
        ]
      },
      {
        "id": "p4",
        "order": 4,
        "sentences": [
          {
            "id": "s11",
            "text": "The theremin’s strange sound isn’t for everyone."
          },
          {
            "id": "s12",
            "text": "It can even sound spooky."
          },
          {
            "id": "s13",
            "text": "You often hear it in old sci-fi movies."
          }
        ]
      }
    ]
  },
