  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Geckos are amazing lizards."
          },
          {
            "id": "s2",
            "text": "They can climb walls like Spider-Man!"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "How do geckos climb like Spider-Man?"
          },
          {
            "id": "s4",
            "text": "They have special feet."
          },
          {
            "id": "s5",
            "text": "A gecko foot has millions of tiny hairs on it."
          },
          {
            "id": "s6",
            "text": "These hairs stick to surfaces."
          },
          {
            "id": "s7",
            "text": "Geckos can control these hairs."
          },
          {
            "id": "s8",
            "text": "This lets it"
          },
          {
            "id": "s9",
            "text": "turn its stickiness on and off."
          },
          {
            "id": "s10",
            "text": "A gecko can even move quickly upside down!"
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s11",
            "text": "Scientists are studying geckos’ feet."
          },
          {
            "id": "s12",
            "text": "They want to make a tape that will let them stick to walls, just like a gecko."
          }
        ]
      }
    ]
  },
