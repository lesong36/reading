  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Today, we see many pictures made of pixels."
          },
          {
            "id": "s2",
            "text": "We see them on TV and computer screens."
          },
          {
            "id": "s3",
            "text": "Pixels are small dots of colored light."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "Using dots to make pictures is an old idea."
          },
          {
            "id": "s5",
            "text": "Artists have done it for a long time."
          },
          {
            "id": "s6",
            "text": "Georges Seurat was an artist in the 1800s."
          },
          {
            "id": "s7",
            "text": "He made paintings with dots."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "Look at his paintings from far away."
          },
          {
            "id": "s9",
            "text": "You see a beautiful picture."
          },
          {
            "id": "s10",
            "text": "Then come closer."
          },
          {
            "id": "s11",
            "text": "Look again."
          },
          {
            "id": "s12",
            "text": "You just see dots!"
          }
        ]
      }
    ]
  },
