  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "How do you stay healthy?"
          },
          {
            "id": "s2",
            "text": "Do you exercise?"
          },
          {
            "id": "s3",
            "text": "Do you eat healthy food?"
          },
          {
            "id": "s4",
            "text": "Do you make art?"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "Making art is good for you."
          },
          {
            "id": "s6",
            "text": "It helps your brain."
          },
          {
            "id": "s7",
            "text": "It helps you relax."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "Doctors often use art to help people."
          },
          {
            "id": "s9",
            "text": "For example, people sometimes have bad dreams."
          },
          {
            "id": "s10",
            "text": "And they’re not sure why."
          },
          {
            "id": "s11",
            "text": "The doctor can ask them to draw the dreams."
          },
          {
            "id": "s12",
            "text": "Then they discuss the pictures."
          },
          {
            "id": "s13",
            "text": "This helps people understand their feelings."
          },
          {
            "id": "s14",
            "text": "Then they feel better."
          }
        ]
      }
    ]
  },
