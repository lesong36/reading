        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "John Isner and Nicolas Mahut played a tennis match at a tournament in 2010."
          },
          {
            "id": "s2",
            "text": "To win a set, a player must win six games."
          },
          {
            "id": "s3",
            "text": "And the player must be two games ahead."
          },
          {
            "id": "s4",
            "text": "Isner and Mahut could not do this in the final set."
          },
          {
            "id": "s5",
            "text": "So the game went on and on."
          },
          {
            "id": "s6",
            "text": "The set lasted for 8 hours and 11 minutes!"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s7",
            "text": "Eventually, Isner won the final set by 70 games to 68."
          },
          {
            "id": "s8",
            "text": "The match took a total of 11 hours and 5 minutes."
          },
          {
            "id": "s9",
            "text": "It was the longest tennis match ever!"
          }
        ]
      }
    ]
  },
