  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Long ago, armies did not have guns."
          },
          {
            "id": "s2",
            "text": "Soldiers fought with their bodies."
          },
          {
            "id": "s3",
            "text": "They used their hands and feet."
          },
          {
            "id": "s4",
            "text": "Sometimes they had weapons."
          },
          {
            "id": "s5",
            "text": "Sometimes they did not."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "Soldiers had to be very fast."
          },
          {
            "id": "s7",
            "text": "They practiced moving their bodies."
          },
          {
            "id": "s8",
            "text": "They invented fighting styles."
          },
          {
            "id": "s9",
            "text": "These became martial arts."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "Today, martial arts are still popular."
          },
          {
            "id": "s11",
            "text": "They are great for exercise."
          },
          {
            "id": "s12",
            "text": "They are good for your health."
          },
          {
            "id": "s13",
            "text": "They also help people protect themselves."
          }
        ]
      }
    ]
  },
