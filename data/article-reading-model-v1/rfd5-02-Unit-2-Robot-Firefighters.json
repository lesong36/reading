        "sentences": [
          {
            "id": "s1",
            "text": "Fighting fires is a dangerous and dirty job."
          },
          {
            "id": "s2",
            "text": "Brave people battle fires every day."
          },
          {
            "id": "s3",
            "text": "In the future, we’ll have robots to protect us."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "There are different firefighting robots."
          },
          {
            "id": "s5",
            "text": "One is small and can fit through doors."
          },
          {
            "id": "s6",
            "text": "A human controls it with a joystick."
          },
          {
            "id": "s7",
            "text": "Another is much bigger."
          },
          {
            "id": "s8",
            "text": "It sprays water 90 meters and"
          },
          {
            "id": "s9",
            "text": "fights huge fires."
          },
          {
            "id": "s10",
            "text": "One firefighting robot even has hands and a face."
          },
          {
            "id": "s11",
            "text": "It walks and carries a hose."
          },
          {
            "id": "s12",
            "text": "Scientists are now teaching it to talk."
          },
          {
            "id": "s13",
            "text": "Soon firefighters will have lots of robot helpers."
          }
        ]
      }
    ]
