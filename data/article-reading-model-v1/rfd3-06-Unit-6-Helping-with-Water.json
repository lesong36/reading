        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "People need fresh water to live."
          },
          {
            "id": "s2",
            "text": "Many people do not have fresh water."
          },
          {
            "id": "s3",
            "text": "They often get sick."
          },
          {
            "id": "s4",
            "text": "Sometimes they die."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "Ryan Hreljac wanted to help."
          },
          {
            "id": "s6",
            "text": "He saved money to dig a well."
          },
          {
            "id": "s7",
            "text": "Wells help people get fresh water."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "Ryan saved $70."
          },
          {
            "id": "s9",
            "text": "This was a lot of money for a six-year-old."
          },
          {
            "id": "s10",
            "text": "But it wasn’t enough."
          },
          {
            "id": "s11",
            "text": "Ryan didn’t give up."
          },
          {
            "id": "s12",
            "text": "He worked harder."
          },
          {
            "id": "s13",
            "text": "He asked other people to help."
          },
          {
            "id": "s14",
            "text": "Soon, he had over $800,000."
          },
          {
            "id": "s15",
            "text": "Now he could help many people!"
          }
        ]
      }
    ]
  },
