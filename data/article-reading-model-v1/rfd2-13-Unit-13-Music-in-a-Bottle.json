        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Glass bottles can make music."
          },
          {
            "id": "s2",
            "text": "Blow across the top of a bottle."
          },
          {
            "id": "s3",
            "text": "The air inside moves, and it makes a note."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "A song is made from many notes."
          },
          {
            "id": "s5",
            "text": "So to play a song, you need many bottles."
          },
          {
            "id": "s6",
            "text": "Put different amounts of water in each bottle."
          },
          {
            "id": "s7",
            "text": "Each bottle has a different amount of air."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "Bottles with more air make lower notes."
          },
          {
            "id": "s9",
            "text": "Bottles with less air make higher notes."
          },
          {
            "id": "s10",
            "text": "Now you can play a song!"
          }
        ]
      }
    ]
  },
