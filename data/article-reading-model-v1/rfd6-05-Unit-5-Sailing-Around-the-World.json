  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "The 15th century is known as the Age of Exploration."
          },
          {
            "id": "s2",
            "text": "There were many brave explorers at the time."
          },
          {
            "id": "s3",
            "text": "One of the most successful was Ferdinand Magellan."
          },
          {
            "id": "s4",
            "text": "He came from Portugal."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "Magellan believed he could travel to India through the Americas."
          },
          {
            "id": "s6",
            "text": "He left Spain with five ships and a 300-man crew."
          },
          {
            "id": "s7",
            "text": "He sailed to South America."
          },
          {
            "id": "s8",
            "text": "He discovered a path through South America."
          },
          {
            "id": "s9",
            "text": "He called it the Straits of Magellan."
          },
          {
            "id": "s10",
            "text": "Then he sailed across the Pacific Ocean."
          },
          {
            "id": "s11",
            "text": "He lost two of his ships doing this."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s12",
            "text": "Sadly, Magellan died in the Philippines."
          },
          {
            "id": "s13",
            "text": "But his crew continued and returned home."
          }
        ]
      }
    ]
  },
