        "sentences": [
          {
            "id": "s1",
            "text": "Many people live in cities now."
          },
          {
            "id": "s2",
            "text": "Cities are full of buildings and streets."
          },
          {
            "id": "s3",
            "text": "Most people live in apartments."
          },
          {
            "id": "s4",
            "text": "They don’t have gardens."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "The people of Baltimore wanted gardens."
          },
          {
            "id": "s6",
            "text": "They looked for empty areas."
          },
          {
            "id": "s7",
            "text": "They worked with students."
          },
          {
            "id": "s8",
            "text": "Together, they started BUGS."
          },
          {
            "id": "s9",
            "text": "This means Baltimore Urban Gardening with Students."
          },
          {
            "id": "s10",
            "text": "They change empty spaces into gardens."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s11",
            "text": "BUGS is going well."
          },
          {
            "id": "s12",
            "text": "The city is becoming greener."
          },
          {
            "id": "s13",
            "text": "Ugly empty spaces are going away."
          },
          {
            "id": "s14",
            "text": "And students are learning about plants."
          }
        ]
      }
    ]
  },
