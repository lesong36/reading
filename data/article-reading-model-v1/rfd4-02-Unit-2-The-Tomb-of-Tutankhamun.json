  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "In 1922, Howard Carter was digging in Egypt."
          },
          {
            "id": "s2",
            "text": "He found something amazing."
          },
          {
            "id": "s3",
            "text": "It was the tomb of King Tutankhamun."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "There were many other tombs in Egypt."
          },
          {
            "id": "s5",
            "text": "But most had been opened."
          },
          {
            "id": "s6",
            "text": "This one was hidden from thieves."
          },
          {
            "id": "s7",
            "text": "Nothing was missing."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s8",
            "text": "The rooms were full of beautiful objects from 1300 BCE."
          },
          {
            "id": "s9",
            "text": "There were statues and paintings."
          },
          {
            "id": "s10",
            "text": "There was furniture and jars."
          },
          {
            "id": "s11",
            "text": "In the middle was a gold box."
          },
          {
            "id": "s12",
            "text": "It contained the mummy of the king."
          }
        ]
      },
      {
        "id": "p4",
        "order": 4,
        "sentences": [
          {
            "id": "s13",
            "text": "Experts now study these objects to learn about ancient Egypt."
          }
        ]
      }
    ]
  },
