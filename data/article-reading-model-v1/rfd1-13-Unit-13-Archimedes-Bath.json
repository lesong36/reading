        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Things take up space."
          },
          {
            "id": "s2",
            "text": "That space is its volume."
          },
          {
            "id": "s3",
            "text": "We can find a box’s volume."
          },
          {
            "id": "s4",
            "text": "We use math."
          },
          {
            "id": "s5",
            "text": "A box is simple."
          },
          {
            "id": "s6",
            "text": "Other shapes aren’t."
          },
          {
            "id": "s7",
            "text": "Finding their volume is hard."
          },
          {
            "id": "s8",
            "text": "But Archimedes learned a way."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s9",
            "text": "He filled a bath."
          },
          {
            "id": "s10",
            "text": "He sat in it."
          },
          {
            "id": "s11",
            "text": "Some water poured out."
          },
          {
            "id": "s12",
            "text": "How much water?"
          },
          {
            "id": "s13",
            "text": "His body’s volume."
          },
          {
            "id": "s14",
            "text": "Archimedes understood this."
          },
          {
            "id": "s15",
            "text": "He was excited."
          },
          {
            "id": "s16",
            "text": "He ran outside and shouted."
          },
          {
            "id": "s17",
            "text": "But he wasn’t wearing any clothes!"
          }
        ]
      }
    ]
  },
