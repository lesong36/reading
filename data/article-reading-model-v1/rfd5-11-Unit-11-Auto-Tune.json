  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Singing is never perfect."
          },
          {
            "id": "s2",
            "text": "But fixing it used to take a long time."
          },
          {
            "id": "s3",
            "text": "Engineers recorded a song many times."
          },
          {
            "id": "s4",
            "text": "Then, they took the best parts and put them together."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "In 1997, Auto-Tune changed everything."
          },
          {
            "id": "s6",
            "text": "Engineers recorded a song once."
          },
          {
            "id": "s7",
            "text": "Then, the software could make it perfect."
          },
          {
            "id": "s8",
            "text": "The song still sounded natural."
          },
          {
            "id": "s9",
            "text": "Nearly every singer wanted to use Auto-Tune."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "Engineers started using Auto-Tune in creative new ways."
          },
          {
            "id": "s11",
            "text": "They moved up and down a few tones very quickly."
          },
          {
            "id": "s12",
            "text": "The singer sounded like a robot."
          },
          {
            "id": "s13",
            "text": "Now Auto-Tune is used in almost every song."
          }
        ]
      }
    ]
  },
