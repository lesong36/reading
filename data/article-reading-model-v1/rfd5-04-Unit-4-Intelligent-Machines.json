        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Do you have a robot friend?"
          },
          {
            "id": "s2",
            "text": "In the future, you might."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "Computers and robots have developed a lot."
          },
          {
            "id": "s4",
            "text": "The first computers were created in the Second World War."
          },
          {
            "id": "s5",
            "text": "They could understand enemy messages."
          },
          {
            "id": "s6",
            "text": "By the 1950s, computers could solve difficult math problems."
          },
          {
            "id": "s7",
            "text": "The first intelligent robot was built in the"
          },
          {
            "id": "s8",
            "text": "1970s."
          },
          {
            "id": "s9",
            "text": "Now computers play games like chess and Go."
          },
          {
            "id": "s10",
            "text": "They can even beat human champions."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s11",
            "text": "Many people think computers and robots will soon be more like us."
          },
          {
            "id": "s12",
            "text": "They may soon think and talk."
          },
          {
            "id": "s13",
            "text": "What will they talk about?"
          }
        ]
      }
    ]
  },
