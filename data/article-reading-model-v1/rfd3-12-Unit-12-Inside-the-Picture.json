  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Photographs are images."
          },
          {
            "id": "s2",
            "text": "These images look real."
          },
          {
            "id": "s3",
            "text": "They can feel like looking in a window."
          },
          {
            "id": "s4",
            "text": "You can climb through a window."
          },
          {
            "id": "s5",
            "text": "Can you climb into a photo?"
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "360-degree cameras have many lenses."
          },
          {
            "id": "s7",
            "text": "They take many pictures at once."
          },
          {
            "id": "s8",
            "text": "Each picture is from a different direction."
          },
          {
            "id": "s9",
            "text": "A computer puts the pictures together."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "You can view the picture through a headset."
          },
          {
            "id": "s11",
            "text": "Turn left."
          },
          {
            "id": "s12",
            "text": "The picture turns left."
          },
          {
            "id": "s13",
            "text": "Turn right."
          },
          {
            "id": "s14",
            "text": "The picture turns right."
          },
          {
            "id": "s15",
            "text": "It feels like you’re inside the picture."
          }
        ]
      }
    ]
  },
