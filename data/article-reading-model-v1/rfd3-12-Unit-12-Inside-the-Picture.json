        "topic": {
          "label": "照片的错觉"
        },
        "main_idea": {
          "text": "照片看起来像真实的窗户，让人产生可以走进去的错觉。"
        },
        "key_details": [
          {
            "source_ids": [
              "s1",
              "s2"
            ],
            "meaning": "照片是图像，但看起来非常真实。"
          },
          {
            "source_ids": [
              "s3"
            ],
            "meaning": "看照片就像在看窗户。"
          },
          {
            "source_ids": [
              "s4",
              "s5"
            ],
            "meaning": "窗户可以爬过去，引发读者思考是否能爬进照片。"
