  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Hieroglyphics are the writing system of ancient Egypt."
          },
          {
            "id": "s2",
            "text": "They were used 5,000 years ago."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "Hieroglyphics are complicated."
          },
          {
            "id": "s4",
            "text": "So most people then couldn’t read or write."
          },
          {
            "id": "s5",
            "text": "There are hundreds of pictures."
          },
          {
            "id": "s6",
            "text": "Some are for one sound."
          },
          {
            "id": "s7",
            "text": "Others are for whole words."
          },
          {
            "id": "s8",
            "text": "Most languages are written in one direction."
          },
          {
            "id": "s9",
            "text": "But hieroglyphics can be written in any direction."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "For a long time, no one could read hieroglyphics."
          },
          {
            "id": "s11",
            "text": "In 1799, a French soldier discovered the Rosetta Stone."
          },
          {
            "id": "s12",
            "text": "This stone had the same text written in hieroglyphics and Greek."
          },
          {
            "id": "s13",
            "text": "Experts could use it as a dictionary to translate."
          }
        ]
      }
    ]
  },
