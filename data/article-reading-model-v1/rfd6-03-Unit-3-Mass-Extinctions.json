  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "A plant or animal goes extinct when all of its kind die out."
          },
          {
            "id": "s2",
            "text": "Sometimes, many plants and animals go extinct at the same time."
          },
          {
            "id": "s3",
            "text": "This is a mass extinction."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "There have been several mass extinctions."
          },
          {
            "id": "s5",
            "text": "Each time, the conditions changed on our planet."
          },
          {
            "id": "s6",
            "text": "The climate changed, or the air changed."
          },
          {
            "id": "s7",
            "text": "Sometimes, it was because of a volcano or an asteroid."
          },
          {
            "id": "s8",
            "text": "This last happened 66 million years ago."
          },
          {
            "id": "s9",
            "text": "Then, all the dinosaurs died out."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "Now the temperature on Earth is rising."
          },
          {
            "id": "s11",
            "text": "This is because of pollution."
          },
          {
            "id": "s12",
            "text": "We should be careful."
          },
          {
            "id": "s13",
            "text": "We might cause the next mass extinction!"
          }
        ]
      }
    ]
  },
