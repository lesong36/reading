        },
        "main_idea": {
          "text": "当所有同类生物都死亡时，就发生了灭绝，如果同时发生很多，就是大灭绝。"
        },
        "key_details": [
          {
            "source_ids": [
              "s1"
            ],
            "meaning": "灭绝意味着一个物种的所有个体都消失了。"
