        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Scientists have a way to find the weight of a planet."
          },
          {
            "id": "s2",
            "text": "They look at a planet’s moons."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "Scientists need to know two things."
          },
          {
            "id": "s4",
            "text": "They need to know the distance between the planet and the moon."
          },
          {
            "id": "s5",
            "text": "And they also need to know how long it takes the object to orbit the"
          },
          {
            "id": "s6",
            "text": "planet once."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s7",
            "text": "This tells them about the gravity pulling on the moon."
          },
          {
            "id": "s8",
            "text": "The gravity comes from the weight of the planet."
          },
          {
            "id": "s9",
            "text": "A heavy planet pulls harder on its moons."
          },
          {
            "id": "s10",
            "text": "So they will orbit the planet"
          },
          {
            "id": "s11",
            "text": "quickly."
          }
        ]
      }
    ]
  },
