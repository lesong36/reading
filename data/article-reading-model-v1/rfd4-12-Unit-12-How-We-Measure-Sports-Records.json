        "sentences": [
          {
            "id": "s1",
            "text": "How do we measure time in sports?"
          },
          {
            "id": "s2",
            "text": "People used a stopwatch in the past."
          },
          {
            "id": "s3",
            "text": "It’s more advanced now."
          },
          {
            "id": "s4",
            "text": "Let’s look at the 100-meter race."
          },
          {
            "id": "s5",
            "text": "Judges use lasers to measure time."
          },
          {
            "id": "s6",
            "text": "They can also use a special camera."
          },
          {
            "id": "s7",
            "text": "This camera can take 2,000 pictures a second!"
          },
          {
            "id": "s8",
            "text": "These are very accurate tools."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s9",
            "text": "Marathons are longer races."
          },
          {
            "id": "s10",
            "text": "They need a different tool."
          },
          {
            "id": "s11",
            "text": "Marathon runners use a device in their shoes."
          },
          {
            "id": "s12",
            "text": "This gives information about their speed."
          },
          {
            "id": "s13",
            "text": "It also tells the judges their"
          },
          {
            "id": "s14",
            "text": "time."
          }
        ]
      }
    ]
  },
