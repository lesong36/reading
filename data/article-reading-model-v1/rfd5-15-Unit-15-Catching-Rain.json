  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Rain is important."
          },
          {
            "id": "s2",
            "text": "It gives us water to grow food."
          },
          {
            "id": "s3",
            "text": "But it can also be dangerous."
          },
          {
            "id": "s4",
            "text": "Floods can wipe out whole villages."
          },
          {
            "id": "s5",
            "text": "Luckily, scientists have good tools to study rain."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "One tool is called a disdrometer."
          },
          {
            "id": "s7",
            "text": "It uses light."
          },
          {
            "id": "s8",
            "text": "It tells scientists how fast rain is falling."
          },
          {
            "id": "s9",
            "text": "It measures the size and speed of raindrops."
          },
          {
            "id": "s10",
            "text": "Larger drops fall faster."
          },
          {
            "id": "s11",
            "text": "They also contain"
          },
          {
            "id": "s12",
            "text": "many times more water."
          },
          {
            "id": "s13",
            "text": "Scientists can tell how much rain is falling per hour."
          },
          {
            "id": "s14",
            "text": "This helps them plan how to best use water."
          },
          {
            "id": "s15",
            "text": "And how to defend us from it."
          }
        ]
      }
    ]
  },
