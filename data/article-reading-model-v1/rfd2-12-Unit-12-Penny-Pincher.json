        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "“Penny pinchers” count every penny."
          },
          {
            "id": "s2",
            "text": "They never spend more than they have to."
          },
          {
            "id": "s3",
            "text": "This doesn’t sound fun."
          },
          {
            "id": "s4",
            "text": "But it’s a good idea."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s5",
            "text": "Do you buy a snack every day?"
          },
          {
            "id": "s6",
            "text": "You may be spending too much."
          },
          {
            "id": "s7",
            "text": "A snack may cost a dollar."
          },
          {
            "id": "s8",
            "text": "That’s seven dollars a week!"
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "Buy snacks in bulk."
          },
          {
            "id": "s10",
            "text": "This means “a lot at one time.”"
          },
          {
            "id": "s11",
            "text": "Buy a box of snacks."
          },
          {
            "id": "s12",
            "text": "You’ll save money."
          },
          {
            "id": "s13",
            "text": "Just be careful."
          },
          {
            "id": "s14",
            "text": "Don’t eat them all at once!"
          }
        ]
      }
    ]
  },
