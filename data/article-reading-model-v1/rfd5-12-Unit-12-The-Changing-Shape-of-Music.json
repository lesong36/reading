  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Listening to music has changed a lot."
          },
          {
            "id": "s2",
            "text": "Long ago, you could only listen to music at concert halls."
          },
          {
            "id": "s3",
            "text": "Starting in the 1850s, people could listen to music at home."
          },
          {
            "id": "s4",
            "text": "Machines played music on tubes or disks."
          },
          {
            "id": "s5",
            "text": "But these machines were too heavy to take around."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s6",
            "text": "That changed in 1983."
          },
          {
            "id": "s7",
            "text": "With the Sony Walkman, people could take music everywhere."
          },
          {
            "id": "s8",
            "text": "It played music on cassettes."
          },
          {
            "id": "s9",
            "text": "And it fit in a pocket."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s10",
            "text": "Now listening to music is convenient."
          },
          {
            "id": "s11",
            "text": "Your computer and phone can play MP3 files."
          },
          {
            "id": "s12",
            "text": "You can also stream music over the internet."
          }
        ]
      }
    ]
  },
