  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Airlines put barcodes on your luggage."
          },
          {
            "id": "s2",
            "text": "Theaters put them on your movie tickets."
          },
          {
            "id": "s3",
            "text": "They are everywhere."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "A barcode looks like black stripes."
          },
          {
            "id": "s5",
            "text": "Some stripes are thin."
          },
          {
            "id": "s6",
            "text": "Others are thicker."
          },
          {
            "id": "s7",
            "text": "A machine uses a laser to scan them."
          },
          {
            "id": "s8",
            "text": "It reads the stripes as numbers."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "Barcodes are useful for some companies."
          },
          {
            "id": "s10",
            "text": "Supermarkets and shipping companies handle lots of items."
          },
          {
            "id": "s11",
            "text": "They need to scan them quickly."
          }
        ]
      },
      {
        "id": "p4",
        "order": 4,
        "sentences": [
          {
            "id": "s12",
            "text": "Now there are better barcodes."
          },
          {
            "id": "s13",
            "text": "They are called QR codes."
          },
          {
            "id": "s14",
            "text": "You can scan them with your phone."
          },
          {
            "id": "s15",
            "text": "They use dots instead of bars."
          },
          {
            "id": "s16",
            "text": "And they hold more information."
          }
        ]
      }
    ]
  },
