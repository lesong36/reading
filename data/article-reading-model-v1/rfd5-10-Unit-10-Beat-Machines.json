  "content": {
    "paragraphs": [
      {
        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Drum machines have recordings of instruments like drums and cymbals."
          },
          {
            "id": "s2",
            "text": "You program beats with these sounds."
          },
          {
            "id": "s3",
            "text": "Drum machines are great, but not everyone likes them."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s4",
            "text": "Drum machines are better than human drummers in some ways."
          },
          {
            "id": "s5",
            "text": "They play faster and longer."
          },
          {
            "id": "s6",
            "text": "They never get tired."
          },
          {
            "id": "s7",
            "text": "They don’t make mistakes."
          },
          {
            "id": "s8",
            "text": "And they play a wider variety of sounds."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s9",
            "text": "To some people, drum machines’ beats are too perfect."
          },
          {
            "id": "s10",
            "text": "Human drummers make small changes in the beat."
          },
          {
            "id": "s11",
            "text": "These add feeling to the music."
          },
          {
            "id": "s12",
            "text": "Drum machines don’t do this."
          },
          {
            "id": "s13",
            "text": "To some people, human drummers are always better."
          }
        ]
      }
    ]
  },
