        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Human language seems unique."
          },
          {
            "id": "s2",
            "text": "But other animals also have ways to communicate."
          }
        ]
      },
      {
        "id": "p2",
        "order": 2,
        "sentences": [
          {
            "id": "s3",
            "text": "Ants use chemicals."
          },
          {
            "id": "s4",
            "text": "An ant leaves a chemical path."
          },
          {
            "id": "s5",
            "text": "Other ants follow it to the food."
          }
        ]
      },
      {
        "id": "p3",
        "order": 3,
        "sentences": [
          {
            "id": "s6",
            "text": "Bees do a special dance."
          },
          {
            "id": "s7",
            "text": "A bee moves around."
          },
          {
            "id": "s8",
            "text": "Its body and wings vibrate."
          },
          {
            "id": "s9",
            "text": "This shows where flowers are."
          }
        ]
      },
      {
        "id": "p4",
        "order": 4,
        "sentences": [
          {
            "id": "s10",
            "text": "Elephants use low sounds."
          },
          {
            "id": "s11",
            "text": "These sounds travel over long distances."
          }
        ]
      },
      {
        "id": "p5",
        "order": 5,
        "sentences": [
          {
            "id": "s12",
            "text": "Dolphins smack their tail on the water."
          },
          {
            "id": "s13",
            "text": "This warns other dolphins of danger."
          }
        ]
      },
      {
        "id": "p6",
        "order": 6,
        "sentences": [
          {
            "id": "s14",
            "text": "Animals like the firefly and the glow-worm have another way."
          },
          {
            "id": "s15",
            "text": "They produce flashes of light to communicate."
          }
        ]
      }
    ]
