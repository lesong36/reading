        "id": "p1",
        "order": 1,
        "sentences": [
          {
            "id": "s1",
            "text": "Long ago, money was coins."
          },
          {
            "id": "s2",
            "text": "The coins were made of gold and silver."
          },
          {
            "id": "s3",
            "text": "Gold and silver are valuable."
          },
          {
            "id": "s4",
            "text": "Today, money is made of paper, too."
          },
          {
            "id": "s5",
            "text": "Paper is not valuable."
          },
          {
            "id": "s6",
            "text": "But paper money works."
          },
          {
            "id": "s7",
            "text": "How?"
          },
          {
            "id": "s8",
            "text": "Governments print paper money."
          },
          {
            "id": "s9",
            "text": "They don’t want people to print fake money."
          },
          {
            "id": "s10",
            "text": "So they make money special."
          },
          {
            "id": "s11",
            "text": "It has art on it."
          },
          {
            "id": "s12",
            "text": "The art has many details."
          },
          {
            "id": "s13",
            "text": "It’s hard to print."
          },
          {
            "id": "s14",
            "text": "Some money has holograms."
          },
          {
            "id": "s15",
            "text": "These are very hard to make."
          }
        ]
      }
    ]
  },
